config("ffrt_test_config") {
  include_dirs = [
    "../../interfaces/kits",
    "../../interfaces/inner_api",
    "../../src",
    "../../src/dfx/async_stack",
    "../../src/dfx/log",
    "../../src/dfx/trace",
    "../../src/dfx/trace_record",
    "../../src/sched",
    "../../include/sched",
    "../../include",
  ]

  cflags = [
    "-fno-rtti",
    "-Wno-unused-variable",
    "-Wno-unused-function",
  ]

  defines = [
    "QOS_INTERVAL",
    "QOS_DISPATCH",
    "QOS_RTG",
    "QOS_MULTI_RTG",
    "QOS_RTG_RT",
    "QOS_CHECKPOINT",
    "QOS_SUBMIT",
    "QOS_DEMO",
    "ATRACE_MODE=0",  # 0 is off, 5 is bytrace, 6 is pmu
    "ATRACE_LEVEL=0",
    "ATRACE_LOGI_ENABLE=0",
    "ATRACE_LOGD_ENABLE=0",
    "ATRACE_SCOPE_LOG_ENABLE=0",
    "ATRACE_DURATION_LOG_ENABLE=0",
    "FFRT_RELEASE",
    "DISABLE_MONITOR",
    "FFRT_ENABLE_HITRACE_CHAIN",
    "FFRT_GITEE",
    "FFRT_PTHREAD_ENABLE",
    "FFRT_PARSE_XML_USE_STUB",
    "FFRT_LOG_LEVEL=3",
    "FFRT_BBOX_ENABLE",
    "FFRT_OH_EVENT_RECORD",
    "FFRT_CO_BACKTRACE_OH_ENABLE",
    "FFRT_OH_TRACE_ENABLE",
    "FFRT_OH_WATCHDOG_ENABLE",
    "FFRT_WORKER_MONITOR",
    "FFRT_TRACE_RECORD_LEVEL=1",
    "FFRT_SEND_EVENT",
    "FFRT_ALLOCATOR_MMAP_SIZE=${ffrt_allocator_mmap_size}",
    "FFRT_STACK_SIZE=${ffrt_stack_size}",
    "FFRT_TRACE_LEVEL=1",
    "QOS_WORKER_FRAME_RTG",
    "USE_OHOS_QOS",
    "OHOS_STANDARD_SYSTEM",
    "TASKSTAT_LOG_ENABLE=0",
  ]
  if (use_musl) {
    defines += [ "TDD_MUSL" ]
  }
  if (ffrt_async_stack_enable) {
    defines += [ "FFRT_ASYNC_STACKTRACE" ]
  }

  if (is_asan && !use_hwasan) {
    defines += [ "FFRT_ASAN_MODE" ]
  }

  if (is_tsan) {
    defines += [ "FFRT_CLOSE_COROUTINE_MODE" ]
  }

  if (is_ohos && !ffrt_task_local_enable) {
    defines += [ "FFRT_TASK_LOCAL_ENABLE" ]
  }

  # build_variant is root/user, default user
  if (build_variant == "root") {
    defines += [ "FFRT_ENG_DEBUG" ]
  }

  if (target_cpu == "arm") {
    defines += [ "APP_USE_ARM" ]
  }
}

# Shared template for FFRT unit test targets.
# Deduplicates the common ohos_unittest boilerplate. Per-target
# variations are passed via invoker:
#   sources:             required, test source files (relative to test/ut/)
#   extra_cflags_cc:     optional, extra compiler flags
#   extra_include_dirs:  optional, extra include dirs
#   extra_deps:          optional, extra deps
#   extra_external_deps: optional, extra external deps
template("ffrt_ut_target") {
  ohos_unittest(target_name) {
    module_out_path = module_output_path
    configs = []
    include_dirs = []
    cflags_cc = []
    deps = []
    external_deps = []

    configs += [ ":ffrt_test_config" ]

    cflags_cc += ffrt_ut_base_cflags_cc
    if (defined(invoker.extra_cflags_cc)) {
      cflags_cc += invoker.extra_cflags_cc
    }

    sources = invoker.sources
    sources += ffrt_ut_base_sources
    deps += ffrt_ut_base_deps

    if (defined(invoker.extra_include_dirs)) {
      include_dirs += invoker.extra_include_dirs
    }
    if (defined(invoker.extra_deps)) {
      deps += invoker.extra_deps
    }
    external_deps += ffrt_ut_base_external_deps
    if (defined(invoker.extra_external_deps)) {
      external_deps += invoker.extra_external_deps
    }

    if (is_standard_system) {
      external_deps += gtest_public_external_deps
    }

    install_enable = true
    part_name = "ffrt"
  }
}

